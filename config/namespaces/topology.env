#!/usr/bin/env bash

export CLIENT_NS="client-ns"
export NODEB_NS="node-b-ns"
export SERVER_NS="server-ns"

export CLIENT_IF="tap-client-vpp"
export CLIENT_IP="10.10.0.2/24"
export CLIENT_ADDR="10.10.0.2"
export VPP_CLIENT_ADDR="10.10.0.1"

export ROOT_UNDERLAY_IF="vpp-underlay"
export VPP_UNDERLAY_IF="host-vpp-underlay"
export NODEB_UNDERLAY_IF="nodeb-underlay"

export VPP_UNDERLAY_ADDR="192.168.50.1"
export NODEB_UNDERLAY_ADDR="192.168.50.2"

export NODEB_SERVER_IF="nodeb-server"
export SERVER_IF="server-link"
export NODEB_SERVER_ADDR="10.20.0.1"
export SERVER_ADDR="10.20.0.2"

export CLIENT_SUBNET="10.10.0.0/24"
export SERVER_SUBNET="10.20.0.0/24"
export UNDERLAY_SUBNET="192.168.50.0/24"

export PSK="secret123"

export VPP_BIN="$HOME/vpp-ipsec-assignment/vpp-src/vpp/build-root/build-vpp_debug-native/vpp/bin/vpp"
export VPPCTL_BIN="$HOME/vpp-ipsec-assignment/vpp-src/vpp/build-root/build-vpp_debug-native/vpp/bin/vppctl"
export VPP_CLI_SOCKET="/run/vpp/cli.sock"
export VPP_STARTUP_CONF="/etc/vpp/startup.conf"
export VPP_LOG="/var/log/vpp/vpp.log"
